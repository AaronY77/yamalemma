This file also re-verifies E4 (A6_trivial, B82_parse, B82_weaker, docstring_2021_b4_false; one
deprecation warning) and that all five PR statements in pr_files/ elaborate (sorry warnings only). -/
namespace E6
open Complex

/-- 2013_a3 docstring (denominators (1-x)^{k+1}) is false: n = 1, x = 1/2, a₀ = -1, a₁ = 1/2. -/
theorem docstring_2013_a3_false :
    ∃ a0 a1 x : ℝ, 0 < x ∧ x < 1 ∧ a0 / (1 - x) + a1 / (1 - x) ^ 2 = 0 ∧
      ¬ ∃ y : ℝ, 0 < y ∧ y < 1 ∧ a0 + a1 * y = 0 := by
  refine ⟨-1, 1/2, 1/2, by norm_num, by norm_num, by norm_num, ?_⟩
  rintro ⟨y, -, hy1, h⟩
  linarith

/-- 2014_b4 docstring (coefficients 2^k·(n-k)) is false: for n = 3 the polynomial is 3 + 4x + 4x²,
which has the non-real root -1/2 + (√2/2) i. -/
theorem docstring_2014_b4_false :
    ∃ z : ℂ, (∑ k ∈ Finset.range 4, (2 : ℂ) ^ k * ((3 - k : ℕ) : ℂ) * z ^ k) = 0 ∧ z.im ≠ 0 := by
  refine ⟨⟨-1/2, Real.sqrt 2 / 2⟩, ?_, ?_⟩
  · have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
    simp only [Finset.sum_range_succ, Finset.sum_range_zero]
    apply Complex.ext <;> simp [pow_succ, Complex.mul_re, Complex.mul_im] <;> nlinarith [h2]
  · simp

/-- 2003_b4: the real-root formalization cannot express f(z) = (z²+1)(z²+2z+2) (a = 1, integer
coefficients 2, 3, 2, 2), although it satisfies the problem's hypotheses with r₁,r₂ = ±i. -/
theorem b4_real_excludes :
    ¬ ∃ r1 r2 r3 r4 : ℝ, ∀ z : ℝ,
      z ^ 4 + 2 * z ^ 3 + 3 * z ^ 2 + 2 * z + 2 = 1 * (z - r1) * (z - r2) * (z - r3) * (z - r4) := by
  rintro ⟨r1, r2, r3, r4, h⟩
  have h0 : (r1 ^ 2 + 1) * ((r1 + 1) ^ 2 + 1) = 0 := by
    have := h r1
    rw [sub_self, mul_zero, zero_mul, zero_mul, zero_mul] at this
    linear_combination this
  have hp : 0 < (r1 ^ 2 + 1) * ((r1 + 1) ^ 2 + 1) := by positivity
  linarith

theorem b4_complex_instance (z : ℂ) :
    z ^ 4 + 2 * z ^ 3 + 3 * z ^ 2 + 2 * z + 2 = 1 * (z - I) * (z - -I) * (z - (-1 + I)) * (z - (-1 - I)) := by
  linear_combination (z ^ 2 + (z + 1) ^ 2 + 1 - I ^ 2) * I_sq

example : I + -I = ((0 : ℚ) : ℂ) ∧ I * -I = ((1 : ℚ) : ℂ) ∧ I + -I ≠ (-1 + I) + (-1 - I) := by
  refine ⟨by simp, by simp, ?_⟩
  intro h
  have := congrArg Complex.re h
  norm_num at this

/-- 2016_a5: in the cyclic group of order 3 with g a generator and h = 1, G is generated by g, h and
g has odd order, but the benchmark's extra hypothesis ¬ closure {g} = ⊤ excludes it. -/
theorem a5_excluded :
    Subgroup.closure {(Multiplicative.ofAdd (1 : ZMod 3))} = ⊤ := by
  refine (Subgroup.eq_top_iff' _).2 fun x => ?_
  rw [Subgroup.mem_closure_singleton]
  refine ⟨((Multiplicative.toAdd x).val : ℤ), ?_⟩
  rw [← ofAdd_zsmul, zsmul_one, Int.cast_natCast, ZMod.natCast_zmod_val]
  rfl

example : Odd (orderOf (Multiplicative.ofAdd (1 : ZMod 3))) := by
  rw [orderOf_ofAdd_eq_addOrderOf, ZMod.addOrderOf_one]
  decide

end E6
