    "proof": "by\n  have hd : deriv (fun x : ℝ => Real.sin (2 * x)) 0 = 2 := by\n    convert ((Real.hasDerivAt_sin (2 * (0 : ℝ))).comp 0 ((hasDerivAt_id 0).const_mul 2)).deriv using 1 <;> norm_num\n  refine ⟨(fun x : ℝ => Real.sin (2 * x)), ⟨?_, ?_, ?_⟩, ?_⟩\n  · fun_prop\n  · intro x\n    exact Real.abs_sin_le_one _\n  · simp [hd]\n  · intro h\n    have h' := h.2.1 (Real.pi / 4)\n    rw [show (2 : ℝ) * (Real.pi / 4) = Real.pi / 2 by ring, Real.sin_pi_div_two] at h'\n    norm_num at h'",
